{
  "name": "PHP & MySQL",
  "image": "mcr.microsoft.com/devcontainers/php:8.2",
  "features": {
    "ghcr.io/devcontainers/features/mysql:1": {
      "version": "8.0"
    }
  },
  "forwardPorts": [8080, 3306],
  "portsAttributes": {
    "8080": {
      "label": "Application",
      "onAutoForward": "openPreview"
    },
    "3306": {
      "label": "MySQL"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "mikestead.dotenv",
        "onecentlin.laravel5-snippets",
        "amiralizadeh9480.laravel-extra-intellisense",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "postCreateCommand": "service mysql start && mysql -u root -e 'CREATE DATABASE IF NOT EXISTS truck_maintenance;' && cp .env.example .env && composer install && npm install && php artisan key:generate",
  "postAttachCommand": {
    "server": "php artisan serve --host 0.0.0.0 --port 8080"
  },
  "remoteEnv": {
    "DB_CONNECTION": "mysql",
    "DB_HOST": "localhost",
    "DB_PORT": "3306",
    "DB_DATABASE": "truck_maintenance",
    "DB_USERNAME": "root",
    "DB_PASSWORD": ""
  }
}
